{
    "name": "iperson1337/opendxp-data-hub",
    "license": "GPL-3.0+",
    "type": "opendxp-bundle",
    "description": "OpenDXP Datahub",
    "config": {
        "sort-packages": true,
        "preferred-install": {
            "open-dxp/opendxp": "source",
            "*": "dist"
        },
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "open-dxp/admin-bundle": "^1.0",
        "open-dxp/opendxp": "^1.1",
        "webonyx/graphql-php": "^15.2.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "symfony/dotenv": "^7.3",
        "symfony/runtime": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "OpenDxp\\Bundle\\DataHubBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenDxp\\Bundle\\DataHubBundle\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=-1",
        "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs-fix": "vendor/bin/php-cs-fixer fix"
    },
    "extra": {
        "opendxp": {
            "bundles": [
                "OpenDxp\\Bundle\\DataHubBundle\\OpenDxpDataHubBundle"
            ]
        }
    }
}
