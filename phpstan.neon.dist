# PHPStan configuration for OpenDXP DataHub.
#
# Static analysis requires the OpenDXP core (open-dxp/opendxp) and the admin
# bundle to be installed: most classes in src/ extend or type-hint core classes.
# Run `composer install` first; autoloading comes from vendor/autoload.php.
parameters:
    level: 5
    paths:
        - src
        - tests
    bootstrapFiles:
        - vendor/autoload.php
        - tests/Stubs/constants.php
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # GraphQL type singletons (`getInstance()` → `new static($config)`) come from
        # upstream; constructors take a config array and are not meant to be overridden.
        - identifier: new.static
        # Type constructors keep an unused `$context`/`$config` parameter for signature
        # compatibility with the type factory; changing them is an API break.
        - identifier: constructor.unusedParameter
